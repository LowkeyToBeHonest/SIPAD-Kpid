const REQUIRED=['ARSIP','USERS','AUDIT','SETTING'];function install(){const ss=SpreadsheetApp.openById(SHEET_ID);REQUIRED.forEach(n=>{let sh=ss.getSheetByName(n);if(!sh)sh=ss.insertSheet(n);sh.clear();});ss.getSheetByName('ARSIP').appendRow(['ID','Nomor','Judul','Kategori','Tanggal','Keterangan','Link','Status']);ss.getSheetByName('USERS').appendRow(['Nama','Email','Role']);ss.getSheetByName('AUDIT').appendRow(['Waktu','User','Aksi','Nomor']);ss.getSheetByName('SETTING').getRange('A1:B3').setValues([['Instansi','KPID Sulawesi Tengah'],['Alamat',''],['Logo','']]);return {success:true};}